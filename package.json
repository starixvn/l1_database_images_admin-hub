{
    "scripts": {
        "submodule:update": " git submodule update --init --recursive --remote",
        "build": "./build-images.sh",
        "docker:test:build": "docker build --file docker/Dockerfile --tag hub.lumigame.com/ldb/admin-hub:test -- .",
        "docker:test:stop": "docker stop AdminHub",
        "docker:test:start": "docker run -d --rm --network host -v ./tests/dev/config.js:/mongoshrc/modules/configs/configs.js -v ./tests/dev/authorized_keys:/home/admin/.ssh/authorized_keys --name AdminHub hub.lumigame.com/ldb/admin-hub:test",
        "docker:test": "pnpm docker:test:build && (pnpm docker:test:stop; pnpm docker:test:start)"
    }
}
